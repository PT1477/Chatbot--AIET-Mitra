rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated student can access only their own chat history.
    match /artifacts/{appId}/users/{userId}/chat_history/{chatId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    // College knowledge is readable to signed-in users; writes are admin-only.
    // Before enabling writes, create custom claims (admin: true) using a trusted server.
    match /college_info/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
